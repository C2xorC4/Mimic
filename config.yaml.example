# Mimic Configuration Example
# Copy to /etc/mimic/config.yaml or use with -c flag

# OS profile to emulate (from profiles/ directory)
profile: "Windows 11"

# Network interface to attach eBPF program to
# interface: eth0
interface: enp73s0f1

# Services to emulate
services:
  - smb
  - msrpc
  - netbios
  - nbns
  - rdp

# Ports that appear closed (send RST on connect)
# Required for nmap OS fingerprinting (needs 1 open + 1 closed port)
closed_ports:
  - 8080
  - 8443

# Service-specific options
service_options:
  # NetBIOS computer name (15 chars max, will be uppercased)
  netbios_name: "WORKSTATION"

  # Domain/workgroup name
  domain: "WORKGROUP"

  # Hostname for services that use it
  hostname: "workstation"

  # MAC address for NBNS responses (format: aa:bb:cc:dd:ee:ff)
  # Leave empty for random locally-administered MAC
  mac_address: ""

  # Response timing jitter (milliseconds) - helps avoid timing fingerprinting
  # Set both to 0 to disable jitter
  jitter_min_ms: 5
  jitter_max_ms: 50

# Logging configuration
logging:
  # Log level: debug, info, warn, error
  level: info

  # Directory for log files
  # - mimic.log: Application events (startup, shutdown, errors)
  # - probes.log: All probe attempts (matched and unmatched) for security monitoring
  # Falls back to ./log/mimic if /var/log/mimic is not writable
  log_dir: /var/log/mimic

  # Use JSON format for FILE logs (recommended for SIEM integration)
  # Set to false for human-readable file logs
  # Note: stdout is ALWAYS human-readable regardless of this setting
  json_mode: true

  # Also output logs to stdout (always human-readable for interactive debugging)
  to_stdout: true

# Security-event pipeline — typed honeypot events (connection, auth_attempt,
# auth_success, cred_capture, enumeration, maze_descent, file_download) fanned out
# to SIEM-ingestible sinks. On by default with an NDJSON event log; the abuse
# detector also consumes this stream.
events:
  enabled: true
  json_file: true            # NDJSON to <log_dir>/events.log (Splunk/Filebeat ingest)
  syslog:
    enabled: false           # RFC 5424 to a syslog collector
    network: udp             # udp | tcp
    address: "127.0.0.1:514"

# Abuse detection + active response. The detector scores each source IP over a
# sliding window from the event stream; crossing the threshold triggers a block.
# DEFAULT IS ALERT-ONLY (enforce: false): it emits a 'block' event ("would block")
# and logs the intent but does NOT touch the firewall. Set enforce: true to add
# real nftables drops (auto-expiring after block_ttl) — ALWAYS list your
# management/SSH subnet in whitelist first to avoid locking yourself out.
defense:
  enabled: true
  enforce: false             # alert-only/dry-run; true => real nft drops
  block_ttl: "1h"            # enforced-block lifetime (nft element timeout)
  window: "60s"              # scoring window
  score: 12                  # score threshold that triggers a block
  cooldown: "5m"             # minimum interval between re-blocking the same source
  whitelist:                 # CIDRs / bare IPs never blocked — put mgmt/SSH here
    - "127.0.0.1"
    - "10.0.254.0/24"

# Path to profiles directory (default: ./profiles)
profiles_dir: ./profiles

# Path to services directory (default: ./services)
services_dir: ./services

# --- Shared credential pool (protocol-neutral) ---------------------------------
# A single source of truth for fake accounts. Honeypots accept these by id, and
# services "leak" them, so a credential discovered in (say) an HTTP body is the
# same one that authenticates against SMB.
credentials:
  - id: backup_svc
    username: svc_backup
    password: V33m@Backup!23
    domain: CORP
  - id: sql_sa
    username: sa
    password: Adm1n@SQL2019!

# --- Cross-service credential-leak wiring --------------------------------------
# Each entry: leak this pool credential via this service at this location. The
# emission point is a {{leak:<id>}} placeholder in the service's response (text
# services) or a type=leak rewrite rule (binary). Location is informational.
credential_leaks:
  - cred: backup_svc
    via: http
    location: body
  - cred: sql_sa
    via: ssh
    location: banner

# --- Stateful SMB honeypot -----------------------------------------------------
smb_honeypot:
  # Allow guest/null sessions to enumerate shares (default: true).
  allow_guest_enum: true

  # Pool credential ids that authenticate against SMB. Empty => all pool creds.
  accept_credentials: [backup_svc, sql_sa]

  # Config-driven virtual filesystem. Omit this block entirely to use the built-in
  # default Windows-like tree. Four modes can be combined:
  #   (a) explicit shares/dirs/files   (b) seeded files (inline or from disk)
  #   (c) randomly-generated structure  (d) runtime infinite maze (fall-through)
  filesystem:
    shares:
      - name: C$
        type: disk_special
        remark: "Default share"
        root:
          dirs:
            - name: Users
              dirs:
                - name: Administrator
                  dirs:
                    - name: Documents
                      files:
                        # (b) inline content with leaked-cred interpolation —
                        # the planted cred is the SAME one SMB accepts.
                        - name: backup_credentials.txt
                          content: |
                            Veeam Backup Service Account
                            Domain: {{cred:backup_svc.domain}}
                            Username: {{cred:backup_svc.username}}
                            Password: {{cred:backup_svc.password}}
                        # (b) seeded file, real content from disk (relative to the
                        # config file's directory)
                        - name: notes.txt
                          seed_file: seeds/notes.txt
      # (d) GENERATIVE TARPIT share: advertised and listable like any real share,
      # but its contents are generated lazily/deterministically and every generated
      # subdirectory is itself generative — infinitely deep, discovered by NORMAL
      # navigation (ls a share -> cd a listed folder -> ls -> ...). Guessing a name
      # that wasn't listed returns NOT_FOUND, exactly like a real share, so there is
      # no "nonexistent path returns data" tell.
      - name: BACKUPS
        type: disk
        remark: "Backup storage"
        maze: true
      - name: IPC$
        type: ipc

    # Generation parameters for maze:true shares/dirs (the `maze: true` flag marks
    # WHERE the tarpit is rooted; this block tunes HOW it generates).
    # max_depth: 0 = unlimited tarpit (a full recursive crawl never terminates —
    # maximal time-waste); set a finite depth (e.g. 8) so ordinary tools complete.
    # `maze: true` can also be set on any directory (DirDef) to root a generative
    # subtree inside an otherwise-static, believable share.
    maze:
      enabled: true
      max_depth: 0
      min_dirs: 3
      max_dirs: 7
      min_files: 2
      max_files: 5

# --- Stateful FTP honeypot (second service on the shared deception core) -------
# Reuses the same neutral content tree + credential pool as smb_honeypot. With no
# `filesystem:` here it inherits smb_honeypot.filesystem, so one definition drives
# both services (navigate the same shares/maze, download the same seeded files,
# and the same leaked credential authenticates here too).
ftp_honeypot:
  allow_anonymous: true
  accept_credentials: [backup_svc]
  root_share: C$
  # filesystem: omitted => inherit smb_honeypot.filesystem
