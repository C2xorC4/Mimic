# Service response templates are byte-exact wire payloads (HTTP headers need CRLF,
# protocol templates are binary) — never let git normalize their line endings.
services/**/responses/** -text

# eBPF artifacts generated by bpf2go are byte-exact; don't normalize/diff them.
internal/ebpf/*.o binary
internal/ebpf/fingerprint_bpfel.go -text
internal/ebpf/fingerprint_bpfeb.go -text

# Captured fixtures (nmap XML etc.) — keep verbatim.
internal/verify/testdata/** -text
